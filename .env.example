# ClipperStash local development environment.
# Copy to `.env` and adjust as needed. Never commit a populated `.env`.

# --- Django -----------------------------------------------------------------
DJANGO_SECRET_KEY=replace-with-a-local-development-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL (matches docker-compose.yml defaults) -----------------------
POSTGRES_DB=clipperstash
POSTGRES_USER=clipperstash
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# --- Redis / Celery ---------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# --- Frontend ---------------------------------------------------------------
# Origins allowed to call the backend from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Where the backend returns the browser after an OAuth round trip.
FRONTEND_BASE_URL=http://localhost:3000

# --- Twitch application -----------------------------------------------------
# Register an application at https://dev.twitch.tv/console/apps and paste its
# credentials here. TWITCH_CLIENT_SECRET is backend-only: never copy it into a
# NEXT_PUBLIC_* variable, a frontend file, or anything the browser can read.
TWITCH_CLIENT_ID=replace-with-your-twitch-client-id
TWITCH_CLIENT_SECRET=replace-with-your-twitch-client-secret
# Must match an OAuth Redirect URL registered on the Twitch application exactly.
TWITCH_REDIRECT_URI=http://localhost:8000/api/twitch/oauth/callback/
